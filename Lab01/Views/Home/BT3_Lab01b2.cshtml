@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Tong hop 6 Layout HTML</title>
</head>
<body style="font-family: Arial, sans-serif; background-color: #fff; padding: 20px; margin: 0;">

    <!-- ================= HÀNG 1: LAYOUT 1, 2, 3 ================= -->
    <div style="width: 100%; margin-bottom: 30px;">

        <!-- LAYOUT 1 -->
        <div style="float: left; width: 30%; margin-right: 3%;">
            <h3 style="text-align: center; margin-bottom: 10px; font-size: 16px;">LAYOUT 1</h3>
            <div style="border: 1px solid #000; height: 220px;">
                <!-- Header -->
                <div style="border-bottom: 1px solid #000; height: 35px;"></div>
                <!-- Body -->
                <div style="height: 184px;">
                    <div style="float: left; width: 30%; height: 100%; border-right: 1px solid #000; box-sizing: border-box;"></div>
                    <div style="float: left; width: 70%; height: 100%;"></div>
                </div>
            </div>
        </div>

        <!-- LAYOUT 2 -->
        <div style="float: left; width: 30%; margin-right: 3%;">
            <h3 style="text-align: center; margin-bottom: 10px; font-size: 16px;">LAYOUT 2</h3>
            <div style="border: 1px solid #000; height: 220px;">
                <!-- Header -->
                <div style="border-bottom: 1px solid #000; height: 35px;"></div>
                <!-- Body -->
                <div style="height: 184px;">
                    <div style="float: left; width: 70%; height: 100%; border-right: 1px solid #000; box-sizing: border-box;"></div>
                    <div style="float: left; width: 30%; height: 100%;"></div>
                </div>
            </div>
        </div>

        <!-- LAYOUT 3 -->
        <div style="float: left; width: 30%;">
            <h3 style="text-align: center; margin-bottom: 10px; font-size: 16px;">LAYOUT 3</h3>
            <div style="border: 1px solid #000; height: 220px;">
                <!-- Header -->
                <div style="border-bottom: 1px solid #000; height: 35px;"></div>
                <!-- Body -->
                <div style="height: 148px;">
                    <div style="float: left; width: 70%; height: 100%; border-right: 1px solid #000; box-sizing: border-box;"></div>
                    <div style="float: left; width: 30%; height: 100%;"></div>
                </div>
                <!-- Footer -->
                <div style="border-top: 1px solid #000; height: 35px;"></div>
            </div>
        </div>

        <div style="clear: both;"></div>
    </div>

    <!-- ================= HÀNG 2: LAYOUT 4, 5, 6 ================= -->
    <div style="width: 100%;">

        <!-- LAYOUT 4 -->
        <div style="float: left; width: 30%; margin-right: 3%;">
            <h3 style="text-align: center; margin-bottom: 10px; font-size: 16px;">LAYOUT 4</h3>
            <div style="border: 1px solid #000; height: 220px;">
                <!-- Header -->
                <div style="border-bottom: 1px solid #000; height: 30px;"></div>
                <!-- Nav -->
                <div style="border-bottom: 1px solid #000; height: 25px;"></div>
                <!-- Body -->
                <div style="height: 163px;">
                    <div style="float: left; width: 30%; height: 100%; border-right: 1px solid #000; box-sizing: border-box;"></div>
                    <div style="float: left; width: 70%; height: 100%;"></div>
                </div>
            </div>
        </div>

        <!-- LAYOUT 5 -->
        <div style="float: left; width: 30%; margin-right: 3%;">
            <h3 style="text-align: center; margin-bottom: 10px; font-size: 16px;">LAYOUT 5</h3>
            <div style="border: 1px solid #000; height: 220px;">
                <!-- Header -->
                <div style="border-bottom: 1px solid #000; height: 30px;">
                    <div style="float: left; width: 50%; height: 100%; border-right: 1px solid #000; box-sizing: border-box;"></div>
                    <div style="float: left; width: 50%; height: 100%;"></div>
                </div>
                <!-- Nav -->
                <div style="border-bottom: 1px solid #000; height: 25px;"></div>
                <!-- Body -->
                <div style="height: 163px;">
                    <div style="float: left; width: 50%; height: 100%; border-right: 1px solid #000; box-sizing: border-box;"></div>
                    <div style="float: left; width: 50%; height: 100%;"></div>
                </div>
            </div>
        </div>

        <!-- LAYOUT 6 -->
        <div style="float: left; width: 30%;">
            <h3 style="text-align: center; margin-bottom: 10px; font-size: 16px;">LAYOUT 6</h3>
            <div style="border: 1px solid #000; height: 220px;">
                <!-- Header -->
                <div style="border-bottom: 1px solid #000; height: 30px;">
                    <div style="float: left; width: 50%; height: 100%; border-right: 1px solid #000; box-sizing: border-box;"></div>
                    <div style="float: left; width: 50%; height: 100%;"></div>
                </div>
                <!-- Body -->
                <div style="height: 153px;">
                    <div style="float: left; width: 25%; height: 100%; border-right: 1px solid #000; box-sizing: border-box;"></div>
                    <div style="float: left; width: 50%; height: 100%; border-right: 1px solid #000; box-sizing: border-box;"></div>
                    <div style="float: left; width: 25%; height: 100%;"></div>
                </div>
                <!-- Footer -->
                <div style="border-top: 1px solid #000; height: 35px;"></div>
            </div>
        </div>

        <div style="clear: both;"></div>
    </div>

</body>
</html>