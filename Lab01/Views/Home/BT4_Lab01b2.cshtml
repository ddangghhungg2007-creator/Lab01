@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Tong hop 6 Layout HTML</title>
</head>
<body>
    <table border="0" width="100%" cellpadding="10" cellspacing="10">
        <tr>
            <td width="33%" valign="top" align="center">
                <h3>LAYOUT 1</h3>
                <table border="1" width="100%" height="220" cellspacing="0" cellpadding="0">
                    <tr height="40">
                        <td colspan="2"></td>
                    </tr>
                    <tr>
                        <td width="30%"></td>
                        <td width="70%"></td>
                    </tr>
                </table>
            </td>

            <td width="33%" valign="top" align="center">
                <h3>LAYOUT 2</h3>
                <table border="1" width="100%" height="220" cellspacing="0" cellpadding="0">
                    <tr height="40">
                        <td colspan="2"></td>
                    </tr>
                    <tr>
                        <td width="70%"></td>
                        <td width="30%"></td>
                    </tr>
                </table>
            </td>

            <td width="34%" valign="top" align="center">
                <h3>LAYOUT 3</h3>
                <table border="1" width="100%" height="220" cellspacing="0" cellpadding="0">
                    <tr height="40">
                        <td colspan="2"></td>
                    </tr>
                    <tr>
                        <td width="70%"></td>
                        <td width="30%"></td>
                    </tr>
                    <tr height="40">
                        <td colspan="2"></td>
                    </tr>
                </table>
            </td>
        </tr>

        <tr>
            <td width="33%" valign="top" align="center">
                <h3>LAYOUT 4</h3>
                <table border="1" width="100%" height="220" cellspacing="0" cellpadding="0">
                    <tr height="35">
                        <td colspan="2"></td>
                    </tr>
                    <tr height="25">
                        <td colspan="2"></td>
                    </tr>
                    <tr>
                        <td width="30%"></td>
                        <td width="70%"></td>
                    </tr>
                </table>
            </td>

            <td width="33%" valign="top" align="center">
                <h3>LAYOUT 5</h3>
                <table border="1" width="100%" height="220" cellspacing="0" cellpadding="0">
                    <tr height="35">
                        <td width="50%"></td>
                        <td width="50%"></td>
                    </tr>
                    <tr height="25">
                        <td colspan="2"></td>
                    </tr>
                    <tr>
                        <td width="50%"></td>
                        <td width="50%"></td>
                    </tr>
                </table>
            </td>
            <td width="34%" valign="top" align="center">
                <h3>LAYOUT 6</h3>
                <table border="1" width="100%" height="220" cellspacing="0" cellpadding="0">
                    <tr height="35">
                        <td colspan="3" width="50%">
                            <table border="1" width="100%" height="100%" cellspacing="0" cellpadding="0">
                                <tr>
                                    <td width="50%"></td>
                                    <td width="50%"></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td width="25%"></td>
                        <td width="50%"></td>
                        <td width="25%"></td>
                    </tr>
                    <tr height="40">
                        <td colspan="3"></td>
                    </tr>
                </table>
            </td>
        </tr>

    </table>

</body>
</html>