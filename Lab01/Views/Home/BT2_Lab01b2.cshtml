@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Sử dụng Table để thiết kế các trang web</title>
</head>
<body>

    <table border="0" width="100%" cellpadding="10" cellspacing="10">
        
        <tr>
          
            <td width="33%" valign="top">
                <h3 align="center">LAYOUT 1</h3>
                <table border="1" width="100%" height="300" cellpadding="5" cellspacing="0">
                    <tr height="50">
                        <td colspan="2" align="center"></td>
                    </tr>
                    <tr>
                        <td width="30%" valign="top"></td>
                        <td width="70%" valign="top" ></td>
                    </tr>
                </table>
            </td>

            <!-- LAYOUT 2 -->
            <td width="33%" valign="top">
                <h3 align="center">LAYOUT 2</h3>
                <table border="1" width="100%" height="300" cellpadding="5" cellspacing="0">
                    <tr height="50">
                        <td colspan="2" align="center"></td>
                    </tr>
                    <tr>
                        <td width="70%" valign="top" ></td>
                        <td width="30%" valign="top"></td>
                    </tr>
                </table>
            </td>

            <!-- LAYOUT 3 -->
            <td width="34%" valign="top">
                <h3 align="center">LAYOUT 3</h3>
                <table border="1" width="100%" height="300" cellpadding="5" cellspacing="0">
                    <tr height="50">
                        <td colspan="2" align="center"></td>
                    </tr>
                    <tr>
                        <td width="70%" valign="top" ></td>
                        <td width="30%" valign="top"></td>
                    </tr>
                    <tr height="40">
                        <td colspan="2" align="center"></td>
                    </tr>
                </table>
            </td>
        </tr>

        <!-- HANG 2: Chua Layout 4, 5, 6 -->
        <tr>
            <!-- LAYOUT 4 -->
            <td width="33%" valign="top">
                <h3 align="center">LAYOUT 4</h3>
                <table border="1" width="100%" height="300" cellpadding="5" cellspacing="0">
                    <tr height="40">
                        <td colspan="2" align="center"></td>
                    </tr>
                    <tr height="30">
                        <td colspan="2" align="center"></td>
                    </tr>
                    <tr>
                        <td width="30%" valign="top"></td>
                        <td width="70%" valign="top" ></td>
                    </tr>
                </table>
            </td>

            <!-- LAYOUT 5 -->
            <td width="33%" valign="top">
                <h3 align="center">LAYOUT 5</h3>
                <table border="1" width="100%" height="300" cellpadding="5" cellspacing="0">
                    <tr height="40">
                        <td width="50%" align="center"></td>
                        <td width="50%" align="center"></td>
                    </tr>
                    <tr height="30">
                        <td colspan="2" align="center"></td>
                    </tr>
                    <tr>
                        <td width="30%" valign="top"></td>
                        <td width="70%" valign="top" ></td>
                    </tr>
                </table>
            </td>

            <!-- LAYOUT 6 -->
            <td width="34%" valign="top">
                <h3 align="center">LAYOUT 6</h3>
                <table border="1" width="100%" height="300" cellpadding="5" cellspacing="0">
                    <tr height="40">
                        <td colspan="2" width="50%" align="center"></td>
                        <td colspan="2" width="50%" align="center"></td>
                    </tr>
                    <tr>
                        <td width="25%" valign="top"></td>
                        <td colspan="2" width="50%" valign="top" ></td>
                        <td width="25%" valign="top"></td>
                    </tr>
                    <tr height="40">
                        <td colspan="4" align="center"></td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

</body>
</html>